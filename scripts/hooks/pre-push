#!/usr/bin/env bash
#
# Link Charts — backend pre-push hook (versionado)
#
# Roda os mesmos checks que o GitHub Actions executa em ci.yml e no job
# `validate` de ci.yml, dentro do container Docker.
#
# Ativação: rode uma vez `bash scripts/setup-hooks.sh` no repo (configura
# core.hooksPath para apontar pra scripts/hooks).
#
# Bypass de emergência: `git push --no-verify`.

set -euo pipefail

REPO_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
SERVICE="app"

cd "$REPO_DIR"

echo ""
echo "🔒 [pre-push] backend — rodando checks da pipeline antes do push"
echo ""

if ! docker compose ps --services --filter "status=running" 2>/dev/null | grep -qx "$SERVICE"; then
	echo "❌ Container '$SERVICE' não está rodando."
	echo "   Suba o ambiente: docker compose up -d"
	echo "   (ou pule com: git push --no-verify)"
	exit 1
fi

echo "✅ Container '$SERVICE' está rodando"
echo ""

echo "🧪 PHPUnit (via composer run test — faz config:clear para limpar cache)"
docker compose exec -T "$SERVICE" composer run test

echo ""
echo "✅ [pre-push] backend OK — push liberado"
echo ""

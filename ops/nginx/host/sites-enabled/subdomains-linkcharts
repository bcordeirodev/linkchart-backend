# Wildcard subdomains: *.linkcharts.com.br -> Laravel backend (port 8000)
# Handles custom user subdomains for the link shortener feature.
# This block must come AFTER the specific server_name blocks (api, redirect, frontend).

server {
    listen 80;
    server_name ~^(?<subdomain>.+)\.linkcharts\.com\.br$;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ~^(?<subdomain>.+)\.linkcharts\.com\.br$;

    # Wildcard certificate (issued by certbot --cert-name linkcharts-wildcard)
    ssl_certificate     /etc/letsencrypt/live/linkcharts-wildcard/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/linkcharts-wildcard/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-RSA-AES256-GCM-SHA512:DHE-RSA-AES256-GCM-SHA512:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    access_log /var/log/nginx/subdomains-linkcharts-access.log;
    error_log  /var/log/nginx/subdomains-linkcharts-error.log;

    # Pagina bio no host do subdominio: a RAIZ (exatamente "/") renderiza no
    # FRONTEND — o middleware do Next detecta o host e serve a bio page sem
    # redirect, entao a URL do usuario E o subdominio. Todos os demais paths
    # (/{slug} dos links curtos) continuam no backend. O backend mantem um 302
    # de fallback na raiz caso este bloco ainda nao esteja aplicado no droplet.
    # PENDENTE DE APLICAR MANUALMENTE no droplet (deploy nao toca sites-enabled).

    # =========================================
    # Filtro de ruido de scanner (2026-08-07)
    #
    # Mesmo filtro do vhost de redirect: este vhost tambem proxya /{slug}
    # direto para o Laravel, entao os probes chegavam ao PHP-FPM por aqui
    # (ex.: GET /index.php visto no log do backend em 07/08). Slugs nunca
    # tem extensao de arquivo. Os blocos "=" e "^~" acima tem precedencia
    # sobre estes regex, entao /_next/, /auth/, /favicon.ico e / seguem
    # intactos.
    # =========================================
    location ~* \.(php|phtml|asp|aspx|jsp|cgi|sql|bak|env|ini|sh|json|xml|yml|yaml)$ {
        return 404;
    }
    location ~* ^/(wp-|wordpress|cgi-bin/|vendor/|\.git) {
        return 404;
    }

    # =========================================
    # Scanner sem extensao (2026-08-07)
    #
    # Probes de painel/debug de framework que NAO casam com o filtro de
    # extensao acima: caiam na rota catch-all do Laravel e viraram ~3.5k
    # 404 em 04/08 (disfarcados de Googlebot, rajadas no mesmo segundo).
    # Slugs nunca usam estes nomes — sao endpoints de admin/debug.
    # =========================================
    location ~* ^/(actuator|_ignition|telescope|server-status|server-info|__debug__|elmah\.axd|solr/|druid/|jmx-console|manager/html|_profiler|graphql) {
        return 404;
    }

    location = / {
        limit_except GET HEAD { deny all; }
        proxy_pass         http://frontend_app;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        proxy_connect_timeout 60s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;
    }

    # Assets e rotas do Next que a pagina bio referencia RELATIVOS ao host do
    # subdominio — sem estes blocos os chunks/fontes 404am no backend e a
    # pagina nunca hidrata (bug encontrado no dev em 27/07; mesmo padrao do
    # vhost linkchart-frontend). Slug "auth" puro nao colide: o prefixo exige
    # a barra e slugs nao contem "/".
    location ^~ /_next/ {
        proxy_pass         http://frontend_app;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    location ^~ /auth/ {
        proxy_pass         http://frontend_app;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    location = /favicon.ico {
        proxy_pass         http://frontend_app;
        proxy_set_header   Host $host;
    }

    location = /icon.svg {
        proxy_pass         http://frontend_app;
        proxy_set_header   Host $host;
    }

    location / {
        proxy_pass         http://backend_app;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        proxy_connect_timeout 60s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;

        proxy_buffer_size    64k;
        proxy_buffers        8 128k;
        proxy_busy_buffers_size 256k;
    }

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/json;
}

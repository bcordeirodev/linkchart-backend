server {
    listen 80;
    server_name linkcharts.com.br www.linkcharts.com.br;
    
    # Redirect HTTP to HTTPS
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name linkcharts.com.br www.linkcharts.com.br;
    
    # SSL Configuration
    ssl_certificate /etc/letsencrypt/live/linkcharts.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/linkcharts.com.br/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    
    # Logs
    access_log /var/log/linkchart/nginx-access.log;
    error_log /var/log/linkchart/nginx-error.log;

    # Allow large cookies (Auth0 __session JWE is ~3.5 KB)
    large_client_header_buffers 4 16k;
    
    # Proxy para aplicação React (container)
    location / {
        proxy_pass http://frontend_app;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        
        # Buffer size for upstream response headers (must fit Set-Cookie: __session=...)
        proxy_buffer_size       16k;
        proxy_buffers           4 16k;
        proxy_busy_buffers_size 16k;
        
        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
    
    # Health check
    location /health {
        proxy_pass http://frontend_app/api/health;
        access_log off;
    }
    
    # Static files
    location /_next/static {
        proxy_pass http://frontend_app;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    
    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/javascript
        application/xml+rss
        application/json;
}

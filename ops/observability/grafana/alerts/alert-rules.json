  {
    "annotations": {
      "summary": "Mais de 5% das requests da API retornando 5xx (5m). Investigue erros do backend no Loki/Tempo."
    },
    "condition": "C",
    "data": [
      {
        "datasourceUid": "grafanacloud-prom",
        "model": {
          "expr": "sum(rate(http_server_request_count_total{http_response_status_class=\"5xx\"}[5m])) / clamp_min(sum(rate(http_server_request_count_total[5m])),0.001)",
          "instant": true,
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "range": false,
          "refId": "A"
        },
        "queryType": "",
        "refId": "A",
        "relativeTimeRange": {"from": 600, "to": 0}
      },
      {
        "datasourceUid": "__expr__",
        "model": {
          "expression": "A",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "reducer": "last",
          "refId": "B",
          "type": "reduce"
        },
        "queryType": "",
        "refId": "B",
        "relativeTimeRange": {"from": 0, "to": 0}
      },
      {
        "datasourceUid": "__expr__",
        "model": {
          "conditions": [{"evaluator": {"params": [0.05], "type": "gt"}}],
          "expression": "B",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "refId": "C",
          "type": "threshold"
        },
        "queryType": "",
        "refId": "C",
        "relativeTimeRange": {"from": 0, "to": 0}
      }
    ],
    "execErrState": "OK",
    "folderUID": "link-charts-alerts",
    "for": "10m",
    "id": 7,
    "isPaused": false,
    "keep_firing_for": "0s",
    "labels": {"app": "link-charts", "severity": "critical"},
    "noDataState": "OK",
    "notification_settings": {
      "group_by": ["grafana_folder", "alertname"],
      "receiver": "Link Charts Email"
    },

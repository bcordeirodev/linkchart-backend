  {
    "annotations": {
      "summary": "p95 de latência da API > 1.5s (5m). Veja as rotas/queries lentas no Tempo (spans de DB/HTTP)."
    },
    "condition": "C",
    "data": [
      {
        "datasourceUid": "grafanacloud-prom",
        "model": {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket[5m])))",

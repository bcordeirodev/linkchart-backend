[
    {
        "id": 7,
        "uid": "efq78j3qb3htsa",
        "orgID": 1,
        "folderUID": "link-charts-alerts",
        "ruleGroup": "link-charts-app",
        "title": "Link Charts \u2014 Taxa de erro 5xx alta (API)",
        "condition": "C",
        "data": [
            {
                "refId": "A",
                "queryType": "",
                "relativeTimeRange": {
                    "from": 600,
                    "to": 0
                },
                "datasourceUid": "grafanacloud-prom",
                "model": {
                    "expr": "sum(rate(http_server_request_count_total{http_response_status_class=\"5xx\"}[5m])) / clamp_min(sum(rate(http_server_request_count_total[5m])),0.001)",
                    "instant": true,
                    "intervalMs": 1000,
                    "maxDataPoints": 43200,
                    "range": false,
                    "refId": "A"
                }
            },
            {
                "refId": "B",
                "queryType": "",
                "relativeTimeRange": {
                    "from": 0,
                    "to": 0
                },
                "datasourceUid": "__expr__",
                "model": {
                    "expression": "A",
                    "intervalMs": 1000,
                    "maxDataPoints": 43200,
                    "reducer": "last",
                    "refId": "B",
                    "type": "reduce"
                }
            },
            {
                "refId": "C",
                "queryType": "",
                "relativeTimeRange": {
                    "from": 0,
                    "to": 0
                },
                "datasourceUid": "__expr__",
                "model": {
                    "conditions": [
                        {
                            "evaluator": {
                                "params": [
                                    0.05
                                ],
                                "type": "gt"
                            }
                        }
                    ],
                    "expression": "B",
                    "intervalMs": 1000,
                    "maxDataPoints": 43200,
                    "refId": "C",
                    "type": "threshold"
                }
            }
        ],
        "updated": "2026-06-25T12:23:21Z",
        "noDataState": "OK",
        "execErrState": "OK",
        "for": "10m",
        "keep_firing_for": "0s",
        "annotations": {
            "summary": "Mais de 5% das requests da API retornando 5xx (5m). Investigue erros do backend no Loki/Tempo."
        },
        "labels": {
            "app": "link-charts",
            "severity": "critical"
        },
        "isPaused": false,
        "notification_settings": {
            "receiver": "Link Charts Email",
            "group_by": [
                "grafana_folder",
                "alertname"
            ]
        },
        "record": null
    },

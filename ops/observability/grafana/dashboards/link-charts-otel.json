{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "targetBlank": true,
      "title": "Frontend Observability (RUM)",
      "tooltip": "Web Vitals, sessões e erros JS do frontend (Faro)",
      "type": "link",
      "url": "/a/grafana-kowalski-app"
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "gridPos": {"h": 3, "w": 24, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        },
        "content": "## Link Charts — Observabilidade (OpenTelemetry → Grafana Cloud)\nBackend (`linkcharts-backend`): **traces · métricas · logs**. Frontend (Faro/RUM): veja **[Frontend Observability](/a/grafana-kowalski-app)** (Web Vitals, sessões, erros JS — fica em app separado). Tudo marcado `environment=production`. _Se algum painel ficar vazio, ajuste o nome do label (ex: `service_name`) ou amplie o time range._",
        "mode": "markdown"
      },
      "pluginVersion": "13.1.0-27822252871",
      "targets": [],
      "title": "",
      "type": "text"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 3},
      "id": 200,
      "panels": [],
      "title": "Resumo",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${prom}"},
      "description": "Redirects executados por minuto no intervalo atual — métrica de volume de tráfego principal do produto.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "green", "value": 0}]
          },
          "unit": "short"
        }
      },
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 4},
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "13.1.0-27822252871",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${prom}"},
          "expr": "sum(rate(redirect_count_total[$__rate_interval])) * 60",
          "refId": "A"
        }
      ],
      "title": "Redirects / min",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${prom}"},
      "description": "Latência p95 do redirect no momento atual — amarelo ≥ 200 ms, vermelho ≥ 500 ms.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 0.2},
              {"color": "red", "value": 0.5}
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 4},
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "13.1.0-27822252871",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${prom}"},
          "expr": "histogram_quantile(0.95, sum by (le) (rate(redirect_duration_seconds_bucket[$__rate_interval])))",
          "refId": "A"
        }
      ],
      "title": "Latência p95 (redirect)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${prom}"},
      "description": "Proporção de redirects com resposta 4xx ou 5xx — amarelo ≥ 1%, vermelho ≥ 5%.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "decimals": 2,
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 0.01},
              {"color": "red", "value": 0.05}
            ]
          },
          "unit": "percentunit"
        }
      },
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 4},
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "13.1.0-27822252871",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${prom}"},
          "expr": "sum(rate(redirect_count_total{http_response_status_code=~\"[45]..\"}[$__rate_interval])) / clamp_min(sum(rate(redirect_count_total[$__rate_interval])), 0.001)",
          "refId": "A"
        }
      ],
      "title": "Taxa de erro (4xx/5xx)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${prom}"},
      "description": "Total absoluto de redirects ocorridos no período selecionado no time picker.",
      "fieldConfig": {
        "defaults": {
          "color": {"fixedColor": "blue", "mode": "fixed"},
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": 0},
              {"color": "red", "value": 80}
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 4},
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "13.1.0-27822252871",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${prom}"},
          "expr": "sum(increase(redirect_count_total[$__range]))",
          "instant": true,
          "queryType": "instant",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Total de redirects (no período)",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 9},
      "id": 201,
      "panels": [],
      "title": "Latência",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${prom}"},
      "description": "Volume de redirects por código de status HTTP ao longo do tempo — empilhado para visualizar a composição do tráfego.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 1,
            "stacking": {"group": "A", "mode": "normal"}
          },
          "unit": "reqps"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 10},
      "id": 6,
      "options": {
        "legend": {"calcs": ["sum"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"hideZeros": false, "mode": "multi", "sort": "none"}
      },
      "pluginVersion": "13.1.0-27822252871",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${prom}"},
          "expr": "sum by (http_response_status_code) (rate(redirect_count_total[$__rate_interval]))",
          "legendFormat": "{{http_response_status_code}}",
          "refId": "A"
        }
      ],
      "title": "Redirects por status (rate)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${prom}"},
      "description": "Percentis p50, p95 e p99 da latência do redirect ao longo do tempo — p99 revela a cauda de usuários mais lentos.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "stacking": {"group": "A", "mode": "none"}
          },
          "unit": "s"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 10},
      "id": 7,
      "options": {
        "legend": {"calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"hideZeros": false, "mode": "multi", "sort": "none"}
      },
      "pluginVersion": "13.1.0-27822252871",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${prom}"},
          "expr": "histogram_quantile(0.50, sum by (le) (rate(redirect_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${prom}"},
          "expr": "histogram_quantile(0.95, sum by (le) (rate(redirect_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${prom}"},
          "expr": "histogram_quantile(0.99, sum by (le) (rate(redirect_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "title": "Latência do redirect (p50 / p95 / p99)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 18},
      "id": 202,
      "panels": [],
      "title": "Distribuição",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${prom}"},
      "description": "Distribuição geográfica dos redirects por país no período — identifica os mercados de maior tráfego.",
      "fieldConfig": {
        "defaults": {
          "color": {"fixedColor": "#73BF69", "mode": "palette-classic"},
          "custom": {"hideFrom": {"legend": false, "tooltip": false, "viz": false}}
        }
      },
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 19},
      "id": 8,
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "showLegend": true, "values": ["value", "percent"]},
        "pieType": "donut",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "sort": "desc",
        "tooltip": {"hideZeros": false, "mode": "single", "sort": "none"}
      },
      "pluginVersion": "13.1.0-27822252871",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${prom}"},
          "expr": "sum by (redirect_country) (increase(redirect_count_total[$__range]))",
          "instant": true,
          "legendFormat": "{{redirect_country}}",
          "refId": "A"
        }
      ],
      "title": "Redirects por país",
      "type": "piechart"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${prom}"},
      "description": "Distribuição dos redirects por tipo de dispositivo (mobile, desktop, tablet) no período selecionado.",
      "fieldConfig": {
        "defaults": {
          "color": {"fixedColor": "#73BF69", "mode": "palette-classic"},
          "custom": {"hideFrom": {"legend": false, "tooltip": false, "viz": false}}
        }
      },
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 19},
      "id": 9,
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "showLegend": true, "values": ["value", "percent"]},
        "pieType": "pie",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "sort": "desc",
        "tooltip": {"hideZeros": false, "mode": "single", "sort": "none"}
      },
      "pluginVersion": "13.1.0-27822252871",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${prom}"},
          "expr": "sum by (redirect_device) (increase(redirect_count_total[$__range]))",
          "instant": true,
          "legendFormat": "{{redirect_device}}",
          "refId": "A"
        }
      ],
      "title": "Redirects por device",
      "type": "piechart"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${prom}"},
      "description": "Distribuição de redirects por código de status HTTP no período — proporção de 302 vs erros 4xx/5xx.",
      "fieldConfig": {
        "defaults": {
          "color": {"fixedColor": "#73BF69", "mode": "palette-classic"},
          "custom": {"hideFrom": {"legend": false, "tooltip": false, "viz": false}}
        }
      },
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 19},
      "id": 10,
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "showLegend": true, "values": ["value", "percent"]},
        "pieType": "pie",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "sort": "desc",
        "tooltip": {"hideZeros": false, "mode": "single", "sort": "none"}
      },
      "pluginVersion": "13.1.0-27822252871",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${prom}"},
          "expr": "sum by (http_response_status_code) (increase(redirect_count_total[$__range]))",
          "instant": true,
          "legendFormat": "{{http_response_status_code}}",
          "refId": "A"
        }
      ],
      "title": "Redirects por status code",
      "type": "piechart"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 27},
      "id": 203,
      "panels": [],
      "title": "Logs & Traces",
      "type": "row"
    },
    {
      "datasource": {"type": "loki", "uid": "${loki}"},
      "description": "Stream de logs de erro do backend enviados via OTLP para o Loki — expanda cada linha para ver o trace_id e contexto completo.",
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 28},
      "id": 11,
      "options": {
        "dedupStrategy": "none",
        "enableInfiniteScrolling": false,
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "pluginVersion": "13.1.0-27822252871",
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "${loki}"},
          "expr": "{service_name=\"linkcharts-backend\"} | detected_level = \"error\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Logs do backend (Loki) — erros enviados via OTLP",
      "type": "logs"
    },
    {
      "datasource": {"type": "tempo", "uid": "${tempo}"},
      "description": "Últimas 20 traces do backend — clique em um trace para abrir o flamegraph e identificar spans lentos.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {"type": "auto"},
            "footer": {"reducers": []},
            "inspect": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": 0},
              {"color": "red", "value": 80}
            ]
          }
        }
      },
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 37},
      "id": 12,
      "options": {"cellHeight": "sm", "showHeader": true},
      "pluginVersion": "13.1.0-27822252871",
      "targets": [
        {
          "datasource": {"type": "tempo", "uid": "${tempo}"},
          "limit": 20,
          "query": "{ resource.service.name = \"linkcharts-backend\" }",
          "queryType": "traceqlSearch",
          "refId": "A",
          "tableType": "traces"
        }
      ],
      "title": "Traces recentes do backend (Tempo)",
      "type": "table"
    }
  ],
  "preload": false,
  "refresh": "30s",
  "schemaVersion": 42,
  "tags": ["link-charts", "opentelemetry"],
  "templating": {
    "list": [
      {
        "allowCustomValue": true,
        "hide": 0,
        "includeAll": false,

        "name": "prom",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "/.*prom.*/",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "allowCustomValue": true,
        "hide": 0,
        "includeAll": false,
        "label": "Logs (Loki)",
        "multi": false,
        "name": "loki",
        "options": [],
        "query": "loki",
        "refresh": 1,
        "regex": "/.*logs.*/",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "allowCustomValue": true,
        "hide": 0,
        "includeAll": false,
        "label": "Traces (Tempo)",
        "multi": false,
        "name": "tempo",
        "options": [],
        "query": "tempo",
        "refresh": 1,
        "regex": "/.*traces.*/",
        "skipUrlSync": false,
        "type": "datasource"
      }
    ]
  },
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
  },
  "timezone": "browser",
  "title": "Link Charts — Observability",
  "uid": "link-charts-otel"
}

# ==========================================
# CONFIGURAÇÃO DE DESENVOLVIMENTO LOCAL
# ==========================================

# Application
APP_NAME="Link Chart"
APP_ENV=local
# APP_KEY=  # generate with: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
REDIRECT_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

# Performance
APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=10

# Logging
LOG_CHANNEL=stack
LOG_STACK=app
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null
LOG_DAILY_DAYS=14

# Per-channel overrides
LOG_APP_DAYS=14
LOG_REDIRECT_LEVEL=info
LOG_REDIRECT_DAYS=7
LOG_REDIRECT_SAMPLE_RATE=1.0
LOG_TRACKING_LEVEL=info
LOG_TRACKING_DAYS=14
LOG_JOBS_LEVEL=info
LOG_JOBS_DAYS=14
LOG_AUTH_LEVEL=info
LOG_AUTH_DAYS=4
LOG_HTTP_LEVEL=warning
LOG_HTTP_DAYS=14
LOG_AUDIT_DAYS=10
LOG_ERRORS_DAYS=14

# Database Configuration - PostgreSQL Docker (mapped to host port 5433)
DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5433
DB_DATABASE=link_chart
DB_USERNAME=postgres
# DB_PASSWORD=  # set to your local Postgres password
DB_PASSWORD=

# Session - File para desenvolvimento
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Broadcasting
BROADCAST_CONNECTION=log

# Filesystem
FILESYSTEM_DISK=local

# Broadcasting
BROADCAST_CONNECTION=log
FILESYSTEMS_CLOUD=local

# Queue
QUEUE_CONNECTION=database

# Session & Cache
CACHE_STORE=database
CACHE_DRIVER=file
CACHE_PREFIX=
CACHE_PATH=

# Redis - Docker para desenvolvimento (mapped to host port 6380)
REDIS_CLIENT=phpredis
REDIS_HOST=localhost
REDIS_PASSWORD=null
REDIS_PORT=6380
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2

# Mail Configuration
MAIL_MAILER=log
MAIL_HOST=localhost
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@linkcharts.com.br"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_TIMEOUT=60
MAIL_VERIFY_PEER=true

# SendGrid API Configuration (production)
# SENDGRID_API_KEY=  # required in production; injected via CI secret
SENDGRID_API_KEY=

# GeoIP Configuration
GEOIP_CACHE_DRIVER=file
GEOIP_CACHE_EXPIRES=86400

# JWT Configuration
# JWT_SECRET=  # generate with: php artisan jwt:secret
JWT_SECRET=
JWT_TTL=1440
JWT_REFRESH_TTL=20160
JWT_ALGO=HS256

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_ATTEMPTS=100
RATE_LIMIT_DECAY_MINUTES=1

# Analytics
ANALYTICS_ENABLED=true
METRICS_COLLECTION=true

# Vite
VITE_APP_NAME="${APP_NAME}"
